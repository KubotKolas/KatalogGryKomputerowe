<Window x:Class="KolasinskiMarcinek.KatalogGryKomputerowe.LocalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KolasinskiMarcinek.KatalogGryKomputerowe.LocalApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <TabControl>
        <!-- Games TAB -->
        <TabItem Header="Gry Komputerowe">
            <DockPanel LastChildFill="True">
                <!-- LEFT: FILTERS AND SEARCH -->
                <StackPanel DockPanel.Dock="Left" Width="121" Margin="10" Height="324">
                    <TextBlock Text="Filtry" FontWeight="Bold" FontSize="14" Margin="5,0,5,10"/>

                    <TextBlock Margin="5,5,5,0">Filtruj po:</TextBlock>
                    <ComboBox Margin="5" Name="filterTypeComboBox" SelectionChanged="FilterTypeComboBox_SelectionChanged">
                        <ComboBoxItem Content="socket type" />
                        <ComboBoxItem Content="manufacturer" />
                        <ComboBoxItem Content="number of cores" />
                    </ComboBox>

                    <ComboBox Margin="5" Name="filterValueComboBox" />
                    <Button Margin="5,0,5,15" Padding="2" Click="CPUApplyFilter">Filtruj</Button>

                    <Separator Margin="5,10"/>

                    <TextBlock Margin="5,5,5,0">Szukaj po nazwie:</TextBlock>
                    <TextBox Margin="5" Name="cpuSearchField" />
                    <Button Margin="5,0,5,15" Padding="2" Click="ApplyCPUSearch">Szukaj</Button>

                    <Separator Margin="5,10"/>

                    <Button Margin="5" Padding="5" Click="RemoveFiltersCPU" Background="#FFF0F0F0">Wyczyść Filtry</Button>
                </StackPanel>

                <!-- RIGHT: DETAILS PANEL -->
                <StackPanel DockPanel.Dock="Right" Margin="10" Width="191" DataContext="{Binding ElementName=CPUList, Path=SelectedItem}" Height="297">
                    <TextBlock Text="Informacje o grze" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Margin="0,2">
                        <Run Text="ID: " FontWeight="Bold"/>
                        <Run Text="{Binding CPUID}"/>
                    </TextBlock>
                    <TextBlock Margin="0,2">
                        <Run Text="Nazwa: " FontWeight="Bold"/>
                        <Run Text="{Binding CPUName}"/>
                    </TextBlock>
                    <TextBlock Margin="0,2">
                        <Run Text="Data wydania: " FontWeight="Bold"/>
                        <Run Text="{Binding CPUCores}"/>
                    </TextBlock>
                    <TextBlock Margin="0,2">
                        <Run Text="Wielosobowe: " FontWeight="Bold"/>
                        <Run Text="{Binding CPUThreads}"/>
                    </TextBlock>
                    <TextBlock Margin="0,2">
                        <Run Text="Gatunek: " FontWeight="Bold"/>
                        <Run Text="{Binding CPUBaseClockGhz}"/> <Run Text="GHz"/>
                    </TextBlock>
                    <TextBlock Margin="0,2">
                        <Run Text="Twórca: " FontWeight="Bold"/>
                        <Run Text="{Binding CPUSocketType}"/>
                    </TextBlock>
                    <!--TextBlock Margin="0,2">
                        <Run Text="Manufacturer: " FontWeight="Bold"/>
                        <Run Text="{Binding CPUProducerName}"/>
                    </TextBlock-->

                    <Button Margin="0,20,0,5" Click="EditCPU" Background="#ffffed">Edytuj wybrane</Button>
                    <Button Margin="0,0,0,5" Click="RemoveCPU" Background="#FF7276">Usuń wybrane</Button>
                    <Button Margin="0,0,0,5" Click="AddCPU" Background="#FFE1FFE1">Dodaj nową grę</Button>
                </StackPanel>

                <Grid Margin="0,10" Width="636">
                    <ListView Name="CPUList" 
          ItemsSource="{Binding ElementName=Window, Path=CPULVM.CPUs}" 
          SelectionChanged="CPUList_SelectionChanged"
          ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nazwa gry" Width="250" DisplayMemberBinding="{Binding CPUName}"/>
                                <GridViewColumn Header="Twórca" Width="200" DisplayMemberBinding="{Binding CPUProducerName}"/>
                                <GridViewColumn Header="Cores" Width="60" DisplayMemberBinding="{Binding CPUCores}"/>
                                <GridViewColumn Header="Socket" Width="100" DisplayMemberBinding="{Binding CPUSocketType}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>
            </DockPanel>
        </TabItem>

        <!-- Developers TAB -->
        <TabItem Header="Twórcy">
            <DockPanel LastChildFill="True">
                <!-- LEFT: FILTERS AND SEARCH -->
                <StackPanel DockPanel.Dock="Left" Width="128" Margin="10" Height="303">
                    <TextBlock Text="Filtry" FontWeight="Bold" FontSize="14" Margin="5,0,5,10"/>

                    <TextBlock Margin="5,5,5,0">Filtruj po adresie:</TextBlock>
                    <ComboBox Margin="5" Name="manufacturerFilterValueComboBox" />
                    <Button Margin="5,0,5,15" Click="ManufacturerApplyFilter">Zastosuj filtr</Button>

                    <Separator Margin="5,10"/>

                    <TextBlock Margin="5,5,5,0">Wyszukuj po nazwie:</TextBlock>
                    <TextBox Margin="5" Name="manufacturerSearchField" />
                    <Button Margin="5,0,5,15" Click="ApplyManufacturerSearch">Szukaj</Button>

                    <Separator Margin="5,10"/>

                    <Button Margin="5" Padding="5" Click="RemoveFiltersManufacturer" Background="#FFF0F0F0">Usuń filtry</Button>
                </StackPanel>

                <!-- RIGHT: DETAILS PANEL -->
                <StackPanel DockPanel.Dock="Right" Margin="10" Width="163" DataContext="{Binding ElementName=ManufacturerList, Path=SelectedItem}" Height="294">
                    <TextBlock Text="Informacje o twórcy" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                    <TextBlock Margin="0,2">
                        <Run Text="ID: " FontWeight="Bold"/>
                        <Run Text="{Binding ManufacturerId}"/>
                    </TextBlock>
                    <TextBlock Margin="0,2">
                        <Run Text="Nazwa: " FontWeight="Bold"/>
                        <Run Text="{Binding ManufacturerName}"/>
                    </TextBlock>
                    <TextBlock Margin="0,2">
                        <Run Text="Address: " FontWeight="Bold"/>
                        <Run Text="{Binding ManufacturerAddress}"/>
                    </TextBlock>

                    <Button Margin="0,20,0,5" Click="EditManufacturer" Background="#ffffed">Edytuj wybrany</Button>
                    <Button Margin="0,0,0,5" Click="RemoveManufacturer" Background="#FF7276">Usuń wybrany</Button>
                    <Button Margin="0,0,0,5" Click="AddManufacturer" Background="#FFE1FFE1">Dodaj nowego twórcę</Button>
                </StackPanel>

                <!-- CENTER: LIST VIEW -->
                <Grid Margin="10">
                    <!-- Removed fixed width and negative margins -->
                    <ListView Name="ManufacturerList" 
              ItemsSource="{Binding ElementName=Window, Path=ManufacturerLVM.Manufacturers}" 
              SelectionChanged="ManufacturerList_SelectionChanged"
              ScrollViewer.VerticalScrollBarVisibility="Visible">
                        <ListView.View>
                            <GridView>
                                <GridViewColumn Header="Nazwa twórcy" Width="250" DisplayMemberBinding="{Binding ManufacturerName}"/>
                                <GridViewColumn Header="Adres" Width="300" DisplayMemberBinding="{Binding ManufacturerAddress}"/>
                            </GridView>
                        </ListView.View>
                    </ListView>
                </Grid>

            </DockPanel>
        </TabItem>
    </TabControl>
</Window>
