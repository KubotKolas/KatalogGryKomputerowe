<Window x:Class="KolasinskiMarcinek.KatalogGryKomputerowe.LocalApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:KolasinskiMarcinek.KatalogGryKomputerowe.LocalApp"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <TabControl>
        <!-- Games TAB -->
        <TabItem Header="Gry Komputerowe">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FILTERS PANEL - TOP SECTION -->
                <Border Grid.Row="0" Margin="10" Padding="10" Background="#FFF8F8F8" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Filtry i wyszukiwanie" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <WrapPanel>
                            <StackPanel Margin="0,0,20,0" Width="200">
                                <TextBlock Margin="0,0,0,5">Filtruj po:</TextBlock>
                                <ComboBox Name="filterTypeComboBox" SelectionChanged="FilterTypeComboBox_SelectionChanged">
                                    <ComboBoxItem Content="socket type" />
                                    <ComboBoxItem Content="manufacturer" />
                                    <ComboBoxItem Content="number of cores" />
                                </ComboBox>
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0" Width="150">
                                <TextBlock Margin="0,0,0,5">Wartość:</TextBlock>
                                <ComboBox Name="filterValueComboBox" />
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0" Width="200">
                                <TextBlock Margin="0,0,0,5">Szukaj po nazwie:</TextBlock>
                                <TextBox Name="cpuSearchField" />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,10,0">
                                <Button Margin="0,0,5,0" Padding="10,5" Click="CPUApplyFilter" Background="#FFE1E1FF">Filtruj</Button>
                                <Button Margin="0,0,5,0" Padding="10,5" Click="ApplyCPUSearch" Background="#FFE1FFE1">Szukaj</Button>
                                <Button Padding="10,5" Click="RemoveFiltersCPU" Background="#FFF0F0F0">Wyczyść Filtry</Button>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- MAIN CONTENT AREA -->
                <Grid Grid.Row="1" Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: LIST VIEW -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <ListView Name="CPUList" 
                          ItemsSource="{Binding ElementName=Window, Path=CPULVM.CPUs}" 
                          SelectionChanged="CPUList_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nazwa gry" Width="250" DisplayMemberBinding="{Binding CPUName}"/>
                                    <GridViewColumn Header="Twórca" Width="200" DisplayMemberBinding="{Binding CPUProducerName}"/>
                                    <GridViewColumn Header="Data Wydania" Width="60" DisplayMemberBinding="{Binding CPUCores}"/>
                                    <!--GridViewColumn Header="Socket" Width="100" DisplayMemberBinding="{Binding CPUSocketType}"/-->
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <!-- RIGHT: DETAILS PANEL -->
                    <Border Grid.Column="1" Padding="10" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC" BorderThickness="1">
                        <StackPanel DataContext="{Binding ElementName=CPUList, Path=SelectedItem}">
                            <TextBlock Text="Informacje o grze" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Margin="0,2">
                                <Run Text="ID: " FontWeight="Bold"/>
                                <Run Text="{Binding CPUID}"/>
                            </TextBlock>
                            <TextBlock Margin="0,2">
                                <Run Text="Nazwa: " FontWeight="Bold"/>
                                <Run Text="{Binding CPUName}"/>
                            </TextBlock>
                            <TextBlock Margin="0,2">
                                <Run Text="Data wydania: " FontWeight="Bold"/>
                                <Run Text="{Binding CPUCores}"/>
                            </TextBlock>
                            <TextBlock Margin="0,2">
                                <Run Text="Wielosobowe: " FontWeight="Bold"/>
                                <Run Text="{Binding CPUThreads}"/>
                            </TextBlock>
                            <TextBlock Margin="0,2">
                                <Run Text="Gatunek: " FontWeight="Bold"/>
                                <Run Text="{Binding CPUBaseClockGhz}"/> <Run Text="GHz"/>
                            </TextBlock>
                            <TextBlock Margin="0,2">
                                <Run Text="Twórca: " FontWeight="Bold"/>
                                <Run Text="{Binding CPUSocketType}"/>
                            </TextBlock>

                            <StackPanel Margin="0,20,0,0">
                                <Button Margin="0,0,0,5" Padding="5" Click="EditCPU" Background="#ffffed">Edytuj wybrane</Button>
                                <Button Margin="0,0,0,5" Padding="5" Click="RemoveCPU" Background="#FF7276">Usuń wybrane</Button>
                                <Button Margin="0,0,0,5" Padding="5" Click="AddCPU" Background="#FFE1FFE1">Dodaj nową grę</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>

        <!-- Developers TAB -->
        <TabItem Header="Twórcy">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- FILTERS PANEL - TOP SECTION -->
                <Border Grid.Row="0" Margin="10" Padding="10" Background="#FFF8F8F8" BorderBrush="#FFCCCCCC" BorderThickness="1">
                    <StackPanel>
                        <TextBlock Text="Filtry i wyszukiwanie" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>

                        <WrapPanel>
                            <StackPanel Margin="0,0,20,0" Width="200">
                                <TextBlock Margin="0,0,0,5">Filtruj po adresie:</TextBlock>
                                <ComboBox Name="manufacturerFilterValueComboBox" />
                            </StackPanel>

                            <StackPanel Margin="0,0,20,0" Width="200">
                                <TextBlock Margin="0,0,0,5">Wyszukuj po nazwie:</TextBlock>
                                <TextBox Name="manufacturerSearchField" />
                            </StackPanel>

                            <StackPanel VerticalAlignment="Bottom" Orientation="Horizontal" Margin="0,0,10,0">
                                <Button Margin="0,0,5,0" Padding="10,5" Click="ManufacturerApplyFilter" Background="#FFE1E1FF">Zastosuj filtr</Button>
                                <Button Margin="0,0,5,0" Padding="10,5" Click="ApplyManufacturerSearch" Background="#FFE1FFE1">Szukaj</Button>
                                <Button Padding="10,5" Click="RemoveFiltersManufacturer" Background="#FFF0F0F0">Usuń filtry</Button>
                            </StackPanel>
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- MAIN CONTENT AREA -->
                <Grid Grid.Row="1" Margin="10,0,10,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="200"/>
                    </Grid.ColumnDefinitions>

                    <!-- LEFT: LIST VIEW -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <ListView Name="ManufacturerList" 
                          ItemsSource="{Binding ElementName=Window, Path=ManufacturerLVM.Manufacturers}" 
                          SelectionChanged="ManufacturerList_SelectionChanged"
                          ScrollViewer.VerticalScrollBarVisibility="Visible">
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Nazwa twórcy" Width="250" DisplayMemberBinding="{Binding ManufacturerName}"/>
                                    <GridViewColumn Header="Adres" Width="300" DisplayMemberBinding="{Binding ManufacturerAddress}"/>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </Grid>

                    <!-- RIGHT: DETAILS PANEL -->
                    <Border Grid.Column="1" Padding="10" Background="#FFF5F5F5" BorderBrush="#FFCCCCCC" BorderThickness="1">
                        <StackPanel DataContext="{Binding ElementName=ManufacturerList, Path=SelectedItem}">
                            <TextBlock Text="Informacje o twórcy" FontWeight="Bold" FontSize="14" Margin="0,0,0,10"/>
                            <TextBlock Margin="0,2">
                                <Run Text="ID: " FontWeight="Bold"/>
                                <Run Text="{Binding ManufacturerId}"/>
                            </TextBlock>
                            <TextBlock Margin="0,2">
                                <Run Text="Nazwa: " FontWeight="Bold"/>
                                <Run Text="{Binding ManufacturerName}"/>
                            </TextBlock>
                            <TextBlock Margin="0,2">
                                <Run Text="Address: " FontWeight="Bold"/>
                                <Run Text="{Binding ManufacturerAddress}"/>
                            </TextBlock>

                            <StackPanel Margin="0,20,0,0">
                                <Button Margin="0,0,0,5" Padding="5" Click="EditManufacturer" Background="#ffffed">Edytuj wybrany</Button>
                                <Button Margin="0,0,0,5" Padding="5" Click="RemoveManufacturer" Background="#FF7276">Usuń wybrany</Button>
                                <Button Margin="0,0,0,5" Padding="5" Click="AddManufacturer" Background="#FFE1FFE1">Dodaj nowego twórcę</Button>
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </TabItem>
    </TabControl>
</Window>